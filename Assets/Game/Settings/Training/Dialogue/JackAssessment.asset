  lines:
  - id: Assessment-0
    speaker: "\uC0AC\uD615"
    text: "\uB290\uB9B0 \uB450 \uD0C0\xB7\uC138 \uD0C0 \uB4A4 \uC9E7\uC740 \uBC18\uBCF5\uC774\uB2E4.
      \uD0A4\uB97C \uB204\uB974\uACE0 \uBC84\uD2F0\uAC70\uB098 \uB9C8\uC9C0\uB9C9
      \uD55C \uD0C0\uB97C \uB367\uBD99\uC774\uC9C0 \uB9C8\uB77C."
    expression: 2
    motion: 1
  - id: Assessment-1
    speaker: "\uC0AC\uD615"
    text: "\uB05D\uAE4C\uC9C0 \uC5F0\uC8FC\uD558\uACE0 Miss 0, \uC815\uD655\uB3C4
      90% \uC774\uC0C1, \uCD94\uAC00 \uC785\uB825 0\uD68C\uBA74 \uD1B5\uACFC\uB2E4.
      \uBC30\uC6B4 \uB3D9\uC791\uC744 \uCC28\uBD84\uD788 \uBCF4\uC5EC\uB77C."
    expression: 2
    motion: 1
