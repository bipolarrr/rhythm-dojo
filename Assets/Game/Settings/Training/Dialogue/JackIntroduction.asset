  m_Script: {fileID: 11500000, guid: efed7040ac1ebe24385781693a832114, type: 3}
  m_Name: JackIntroduction
  m_EditorClassIdentifier: Game.Runtime::RhythmDojo.Content.DialogueSequenceAsset
  sequenceId: Jack-Introduction
  version: 1
  lines:
  - id: Introduction-0
    speaker: "\uC0AC\uD615"
    text: "\uBB38\uC744 \uB450\uB4DC\uB9B4 \uB54C\uB3C4 \uD69F\uC218\uAC00 \uC788\uC9C0.
      \uC190\uAC00\uB77D\uC744 \uC5B9\uC5B4 \uB450\uAE30\uB9CC \uD574\uC11C\uB294
      \uB300\uB2F5\uC774 \uC5C6\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-1
    speaker: "\uC0AC\uD615"
    text: "\uAC19\uC740 \uD0A4\uB97C \uC774\uC5B4 \uCE58\uB294 \uAC83\uC774 \uC7AD\uC774\uB2E4.
      \uB450 \uBC88\uC740 \uB530\uB2E5, \uC138 \uBC88\uC740 \uB530\uB2E4\uB2E5. \uB9E4
      \uD0C0\uACA9 \uB4A4 \uD0A4\uB97C \uB5BC\uC5B4\uC57C \uB2E4\uC74C \uC785\uB825\uC774
      \uB41C\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-2
    speaker: "\uC0AC\uD615"
    text: "\uB124 \uBC15 \uC900\uBE44\uC74C \uB4A4 \uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uC5EC\uC8FC\uB9C8.
      \uC190\uC744 \uC26C\uACE0 \uB178\uD2B8\uC640 \uD0C0\uACA9 \uC21C\uAC04\uC744
      \uBCF4\uAC70\uB77C."
    expression: 5
    motion: 1
