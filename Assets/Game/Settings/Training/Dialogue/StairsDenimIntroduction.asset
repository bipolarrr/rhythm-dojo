  sequenceId: StairsDenim-Introduction
  version: 1
  lines:
  - id: Introduction-0
    speaker: "\uC0AC\uD615"
    text: "\uACC4\uB2E8\uC740 \uBC1C\uB05D\uBCF4\uB2E4 \uB208\uC774 \uBA3C\uC800
      \uC624\uB974\uB294 \uBC95. \uC624\uB298\uC740 \uC190\uAC00\uB77D\uC73C\uB85C
      \uAE38\uC744 \uC77D\uC5B4 \uBCF4\uC790."
    expression: 5
    motion: 1
  - id: Introduction-1
    speaker: "\uC0AC\uD615"
    text: "\uC67C\uCABD\uBD80\uD130 1\xB72\xB73\xB74\uBC88\uC774\uB2E4. 1-2-3-4\uC640
      \uC5ED\uC21C\uC740 \uACC4\uB2E8, \uC5EC\uB7EC \uD0A4\uB97C \uD568\uAED8 \uCE58\uBA70
      \uC870\uD569\uC774 \uAD50\uCC28\uD558\uB294 \uBC30\uCE58\uB294 \uB370\uB2D8\uC774\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-2
    speaker: "\uC0AC\uD615"
    text: "\uB124 \uBC15 \uC900\uBE44\uC74C \uB4A4 \uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uC5EC\uC8FC\uB9C8.
      \uC190\uC744 \uC26C\uACE0 \uB178\uD2B8\uC640 \uD0C0\uACA9 \uC21C\uAC04\uC744
      \uBCF4\uAC70\uB77C."
    expression: 5
    motion: 1
