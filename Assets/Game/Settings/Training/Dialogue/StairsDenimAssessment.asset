  lines:
  - id: Assessment-0
    speaker: "\uC0AC\uD615"
    text: "\uC815\uC21C\xB7\uC5ED\uC21C, \uAD50\uCC28 \uB3D9\uC2DC\uCE58\uAE30, \uBC29\uD5A5
      \uC804\uD658\uC744 \uCC28\uB840\uB85C \uBCF8\uB2E4. \uC678\uC6B4 \uC190\uC21C\uC11C\uBCF4\uB2E4
      \uB2E4\uC74C \uBC30\uCE58\uB97C \uC77D\uAC70\uB77C."
    expression: 2
    motion: 1
  - id: Assessment-1
    speaker: "\uC0AC\uD615"
    text: "\uB05D\uAE4C\uC9C0 \uC5F0\uC8FC\uD558\uACE0 Miss 0, \uC815\uD655\uB3C4
      90% \uC774\uC0C1, \uCD94\uAC00 \uC785\uB825 0\uD68C\uBA74 \uD1B5\uACFC\uB2E4.
      \uBC30\uC6B4 \uB3D9\uC791\uC744 \uCC28\uBD84\uD788 \uBCF4\uC5EC\uB77C."
