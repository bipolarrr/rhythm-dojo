  m_Script: {fileID: 11500000, guid: efed7040ac1ebe24385781693a832114, type: 3}
  m_Name: ChordTrillIntroduction
  m_EditorClassIdentifier: Game.Runtime::RhythmDojo.Content.DialogueSequenceAsset
  sequenceId: ChordTrill-Introduction
  version: 1
  lines:
  - id: Introduction-0
    speaker: "\uC0AC\uD615"
    text: "\uB458\uC774\uC11C \uD55C \uBC1C\uC790\uAD6D\uC774\uB2E4. \uD55C \uC190\uC774
      \uC55E\uC11C \uB098\uAC00\uBA74 \uBC1C\uC790\uAD6D\uC774 \uB450 \uAC1C\uAC00
      \uB418\uACA0\uC9C0."
    expression: 5
    motion: 1
  - id: Introduction-1
    speaker: "\uC0AC\uD615"
    text: "\uB3D9\uCE58\uD2B8\uB9B4\uC740 [1+3]\uACFC [2+4]\uB97C \uAD50\uB300\uB85C
      \uCE58\uB294 \uD328\uD134\uC774\uB2E4. \uAC01 \uC870\uD569\uC758 \uB450 \uD0A4\uB294
      \uD568\uAED8 \uB204\uB974\uACE0, \uB2E4\uC74C \uC870\uD569 \uC804\uC5D0 \uB5BC\uC5B4\uB77C."
    expression: 5
    motion: 1
  - id: Introduction-2
    speaker: "\uC0AC\uD615"
    text: "\uB124 \uBC15 \uC900\uBE44\uC74C \uB4A4 \uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uC5EC\uC8FC\uB9C8.
      \uC190\uC744 \uC26C\uACE0 \uB178\uD2B8\uC640 \uD0C0\uACA9 \uC21C\uAC04\uC744
      \uBCF4\uAC70\uB77C."
    expression: 5
    motion: 1
