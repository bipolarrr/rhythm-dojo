  sequenceId: Burst-Introduction
  version: 1
  lines:
  - id: Introduction-0
    speaker: "\uC0AC\uD615"
    text: "\uBE57\uC904\uAE30\uAC00 \uAD75\uC5B4\uC838\uB3C4 \uD55C \uBC29\uC6B8\uC529
      \uB5A8\uC5B4\uC9C4\uB2E4. \uD3ED\uD0C0\uB3C4 \uD55C \uC74C\uC529 \uC815\uD655\uD788
      \uBC1B\uB294 \uAC83\uC774\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-1
    speaker: "\uC0AC\uD615"
    text: "\uD3ED\uD0C0\uB294 \uC9E7\uC740 \uAC04\uACA9\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294
      \uC5F0\uC18D \uD328\uD134\uC774\uB2E4. BPM 100\uC758 \uD55C \uBC15\uC744 \uB137\uC73C\uB85C
      \uB098\uB208 16\uBD84\uC74C\uD45C, 0.15\uCD08 \uAC04\uACA9\uC73C\uB85C \uCE5C\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-2
    speaker: "\uC0AC\uD615"
    text: "\uB124 \uBC15 \uC900\uBE44\uC74C \uB4A4 \uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uC5EC\uC8FC\uB9C8.
      \uC190\uC744 \uC26C\uACE0 \uB178\uD2B8\uC640 \uD0C0\uACA9 \uC21C\uAC04\uC744
      \uBCF4\uAC70\uB77C."
    expression: 5
    motion: 1
