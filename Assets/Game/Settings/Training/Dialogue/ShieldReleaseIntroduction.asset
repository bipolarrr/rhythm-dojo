  m_Script: {fileID: 11500000, guid: efed7040ac1ebe24385781693a832114, type: 3}
  m_Name: ShieldReleaseIntroduction
  m_EditorClassIdentifier: Game.Runtime::RhythmDojo.Content.DialogueSequenceAsset
  sequenceId: ShieldRelease-Introduction
  version: 1
  lines:
  - id: Introduction-0
    speaker: "\uC0AC\uD615"
    text: "\uBC29\uD328\uB3C4 \uC62C\uB9B4 \uB54C\uC640 \uB0B4\uB9B4 \uB54C\uAC00
      \uC788\uB2E4. \uACC4\uC18D \uC6C0\uCF1C\uC950\uBA74 \uB2E4\uC74C \uB3D9\uC791\uC774
      \uB2A6\uB294 \uBC95\uC774\uC9C0."
    expression: 5
    motion: 1
  - id: Introduction-1
    speaker: "\uC0AC\uD615"
    text: "\uC77C\uBC18 \uB178\uD2B8 \uC9C1\uD6C4 \uAC19\uC740 \uB808\uC778\uC758
      \uB871\uB178\uD2B8\uB97C \uBC1B\uB294\uB2E4. \uB2E8\uD0C0 \uB4A4 \uD0A4\uB97C
      \uB5BC\uACE0 \uB2E4\uC2DC \uB20C\uB7EC \uC720\uC9C0\uD55C\uB2E4. \uAF2C\uB9AC\uAC00
      \uD310\uC815\uC120\uC5D0 \uB2FF\uC744 \uB54C \uC815\uD655\uD788 \uD574\uC81C\uD55C\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-2
    speaker: "\uC0AC\uD615"
    text: "\uB124 \uBC15 \uC900\uBE44\uC74C \uB4A4 \uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uC5EC\uC8FC\uB9C8.
      \uC190\uC744 \uC26C\uACE0 \uB178\uD2B8\uC640 \uD0C0\uACA9 \uC21C\uAC04\uC744
      \uBCF4\uAC70\uB77C."
    expression: 5
    motion: 1
