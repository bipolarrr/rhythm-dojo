  m_Script: {fileID: 11500000, guid: efed7040ac1ebe24385781693a832114, type: 3}
  m_Name: HoldTapIntroduction
  m_EditorClassIdentifier: Game.Runtime::RhythmDojo.Content.DialogueSequenceAsset
  sequenceId: HoldTap-Introduction
  version: 1
  lines:
  - id: Introduction-0
    speaker: "\uC0AC\uD615"
    text: "\uD55C \uC190\uC740 \uAE30\uB465, \uD55C \uC190\uC740 \uBD81\uCC44\uB2E4.
      \uBD81\uC744 \uCE5C\uB2E4\uACE0 \uAE30\uB465\uAE4C\uC9C0 \uBF51\uC9C0\uB294
      \uB9D0\uAC70\uB77C."
    expression: 5
    motion: 1
  - id: Introduction-1
    speaker: "\uC0AC\uD615"
    text: "\uB871\uC7A1\uC740 \uB871\uB178\uD2B8\uB97C \uB204\uB978 \uCC44 \uB2E4\uB978
      \uB808\uC778\uC744 \uCE58\uB294 \uD328\uD134\uC774\uB2E4. \uAE34 \uB178\uD2B8\uC758
      \uAF2C\uB9AC\uAC00 \uD310\uC815\uC120\uC5D0 \uB2FF\uC744 \uB54C\uAE4C\uC9C0
      \uC720\uC9C0\uD558\uACE0 \uADF8\uB54C \uB5C0\uB2E4."
    expression: 5
    motion: 1
  - id: Introduction-2
    speaker: "\uC0AC\uD615"
    text: "\uB124 \uBC15 \uC900\uBE44\uC74C \uB4A4 \uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uC5EC\uC8FC\uB9C8.
      \uC190\uC744 \uC26C\uACE0 \uB178\uD2B8\uC640 \uD0C0\uACA9 \uC21C\uAC04\uC744
      \uBCF4\uAC70\uB77C."
    expression: 5
    motion: 1
