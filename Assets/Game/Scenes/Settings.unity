  m_FontData:
    m_Font: {fileID: 12800000, guid: 50b4af72e8c58404d8b31e07a15daac6, type: 3}
    m_FontSize: 19
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uC791\uC740 \uBC84\uD37C\uB294 \uC751\uB2F5\uC774 \uBE68\uB77C\uC9C0\uC9C0\uB9CC
    \uC18C\uB9AC\uAC00 \uB04A\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4. Unity\uAC00
    \uC9C0\uC6D0\uD558\uB294 \uD06C\uAE30\uB85C \uC870\uC815\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\nDefault\uB294
    \uC571 \uC2DC\uC791 \uC2DC\uC758 \uBC84\uD37C \uD06C\uAE30\uB97C \uBCF5\uC6D0\uD569\uB2C8\uB2E4.
    \uC120\uD0DD\uD55C \uAC12\uC740 \uC571\uC774 \uC2E4\uD589\uB418\uB294 \uB3D9\uC548
    \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\uC774 \uC124\uC815\uC740 Unity \uBBF9\uC11C
    \uBC84\uD37C\uC5D0 \uC801\uC6A9\uB418\uBA70, ASIO \uB4DC\uB77C\uC774\uBC84\uC758
    \uBC84\uD37C\uB97C \uBCC0\uACBD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
